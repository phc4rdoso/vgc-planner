{
  "name": "vgc-gameplan-planner",
  "version": "1.0.0",
  "description": "Flowchart gameplans for VGC matchups, with Pokémon Champions damage calculations.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tooling.json && tsc -p server/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:e2e": "node e2e/smoke.mjs",
    "sprites": "bash scripts/fetch-sprites.sh",
    "check": "npm run typecheck && npm run lint && npm test",
    "dev:api": "wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply vgc-gameplans --local",
    "avatars": "node scripts/fetch-portraits.mjs",
    "deploy": "node scripts/check-sprites.mjs && npm run build && wrangler deploy"
  },
  "dependencies": {
    "@smogon/calc": "^0.12.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "playwright": "^1.50.0",
    "prettier": "^3.3.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "wrangler": "^4.147.0"
  }
}
